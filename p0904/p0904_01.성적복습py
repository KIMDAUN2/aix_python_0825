title=["번호","이름","국어","영어","수학","합계","평균"]
k_title=["no","name","kor","eng","math","total","avg"]
stu= []
sno = 1 #학생성적인원변수,전역변수

def s_mainpoint():
    print("[학생성적프로그램]")
    print("1.학생성적입력")
    print("2.학생성적출력")
    print("3.학생성적수정")
    print("-"*60)
    choice = int(input("원하는 번호 입력"))
    print()
    return choice          #프로그램 실행에서 쓰일 수 있게 리턴값으로 지정

def s_input():
    global sno  #함수 밖에 있는 전역함수를 지역함수로 함수안에서 사용하기 위해 쓰임
    while True:
        no=sno     #번호입력(자동번호 부여)
        name = input(f"{no}번째 이름입력 (0.이전화면 이동)")  #이름입력
        if name =="0":
            break
        kor = int(input("국어점수 :"))      #국어,영어,수학점수 입력
        eng = int(input("영어점수 :"))
        math = int(input("수학점수 :"))
        total = kor+eng+math                #합계,평균 입력
        avg = total/3

        stu.append({"no":no,"name":name,"kor":kor,"eng":eng,"math":math,"total":total,"avg":avg})    #stu리스트에 입력받은거 추가
        print(f"{name}의 학생성적이 입력되었습니다.")
        print()
        sno+=1                             #번호+1
        s_output()                        #입력 후 출력바로받기

def s_output():
    print("[학생성적출력]")
    print("-"*60)
    print("{}\t{}\t{}\t{}\t{}\t{}\t{}".format(*title))               #타이틀 전개연산
    print("-"*60)
    if len(stu)==0:                                                  #stu리스트 길이가 0 이면 데이터 없음
        print("학생데이터가 없습니다.")
    else:                                                            # 있으면 정보받기
        for s in stu:
            print(f"{s['no']}\t{s['name']}\t{s['kor']}\t{s['eng']}\t{s['math']}\t{s['total']}\t{s['avg']:.2f}\t")
    print()

def s_update():
    print("[학생성적수정]")
    name = input("찾으려는 학생을 입력하세요.")              #학생검색
    temp=0
    for i,s in enumerate(stu):                            #번호,stu리스트항목중 name을 찾아 동일학생 찾기
        if s['name']==name:
            print(f"{name}학생을 찾았습니다.")
            temp=1                                      #변수에 들어와진다면 멈춤
            break
    if temp==0:
        print(f"{name}학생이 없습니다.")                   #변수가 없으면 반복
    elif temp == 1:
        print("수정과목선택")
        print("1.국어 2.영어 3.수학")
        choice = int(input("원하는 번호 입력"))            #원하는 번호 입력받기

        print(f"현재{title[choice+1]}점수:{s[k_title[choice+1]]}")                   
        s[k_title[choice+1]]=int(input(f"변경하려는{title[choice+1]}점수:"))
        s['total']=s['kor']+s['eng']+s['math']
        s['avg']=s['total']/3
        print(f"{s[k_title[choice+1]]}점으로 {title[choice+1]}가 변경되었습니다.")        #title[choice+1]=과목의 이름 // s[k_title[choice+1]]= 그 과목의 점수



while True:
    #메인화면
    choice=s_mainpoint()
    #학생성적입력받기
    if choice == 1:
        s_input()
    #학생성적출력
    if choice == 2:
        s_output()
    #학생성적수정
    if choice == 3:
        s_update()