#원의 반지름 입력받아 원의 둘레와 넓이를 구하시오.
#둘레: 2*원주율*반지름
#넓이: 원주율*반지름*반지름

a = float(input("반지름을 입력하세요.>>"))
pi = 3.14
print("넓이 : ",pi*a*a)
print("넓이 : ",pi*a**2)
print("원의 둘레 : ",2*pi*a)

